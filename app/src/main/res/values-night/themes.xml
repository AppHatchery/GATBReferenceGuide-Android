<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.GATBReferenceGuide" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/reddish</item>
        <item name="colorPrimaryVariant">@color/reddish</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="chapterBackgroundColorWhite">#2B2B2B</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/reddish</item>
        <item name="colorSecondaryVariant">@color/reddish</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/reddish</item>

        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="chapterBackgroundColor">#343434</item>
        <item name="chapterBackgroundColorTop">@color/reddish</item>
        <item name="colorBlackWhite">@color/dark_black</item>
        <item name="colorWhiteBlack">@android:color/white</item>

        <item name="savedTopBar">@color/dark_black</item>
        <item name="chartBackgroundColor">@color/reddish</item>
        <item name="chartBackgroundColorTop">#BD998A</item>
        <item name="searchBackgroundColor">@color/reddish</item>
        <item name="chapterBackgroundColorTopSeeAll">#FFBE0A</item>
        <item name="android:textColor">@color/white</item>

        <item name="actionBarStyle">@style/darkActionbar</item>
        <item name="android:windowBackground">#2B2B2B</item>
        <item name="chapterBackgroundColorGrey">#343434</item>

        <item name="toolbarColor">?chartBackgroundColor</item>
        <item name="colorGrayWhite">@color/neutral_200</item>
        <item name="colorWhiteGray">@color/neutral_900</item>
        <item name="colorWhiteDarkBlack">@color/black</item>
        <item name="colorTextBlackWhite">@color/white</item>
        <item name="colorTextBlackWhite2">@color/white</item>
        <item name="dialogBackgroundColor">#2B2B2B</item>
        <item name="dialogEditTextBackgroundColor">#545454</item>
        <item name="dialogButtonLeftColor">#747474</item>
        <item name="iconTintColor">@color/white</item>
        <item name="dialogButtonTextColor">@color/white</item>
        <item name="cardItemBackground">#343434</item>

    </style>


    <style name="darkActionbar" parent="Widget.AppCompat.ActionBar">
        <item name="background">?chartBackgroundColor</item>
    </style>
</resources>