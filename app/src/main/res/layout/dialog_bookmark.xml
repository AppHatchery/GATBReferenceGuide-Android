<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="281dp"
    android:layout_height="185dp"
    android:layout_gravity="center"
    android:background="@drawable/rectangle_2">

    <!-- Bookmark name label -->
    <TextView
        android:id="@+id/bookmarkTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:text="Bookmark name"
        android:textColor="?attr/colorTextBlackWhite"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Input field container -->
    <RelativeLayout
        android:id="@+id/input_container"
        android:layout_width="213dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="30dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="72dp"
        android:clipToOutline="true"
        android:background="@drawable/bookmark_input_background">

        <EditText
            android:id="@+id/bookmarkTitleTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@+id/close_dialog"
            android:background="@android:color/transparent"
            android:gravity="start|center_vertical"
            android:hint="Enter bookmark title..."
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:textColor="?attr/colorTextBlackWhite"
            android:textColorHint="?attr/colorTextBlackWhite2"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/close_dialog"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="2dp"
            android:src="@drawable/ic_baseline_clear_content"
            app:tint="@color/reddish" />

    </RelativeLayout>

    <!-- Cancel button -->
    <TextView
        android:id="@+id/bookmarkCancelButton"
        android:layout_width="141dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="145dp"
        android:background="@drawable/cancel_button_bg"
        android:clickable="true"
        android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="Cancel"
        android:textColor="?attr/dialogButtonTextColor"
        android:textSize="16sp"
        tools:ignore="HardcodedText" />

    <!-- Save button -->
    <TextView
            android:id="@+id/bookmarkSaveButton"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="141dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="145dp"
        android:background="@drawable/save_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
            android:text="Save"
        android:textColor="@color/white"
        android:textSize="16sp"
            tools:ignore="HardcodedText" />

</RelativeLayout>