<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/chapterBackgroundColorWhite">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button"
            style="@style/TextAppearance.AppCompat.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="77dp"
            android:background="@drawable/ic_shape_bg_chapter"
            android:ellipsize="end"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical|start"
            android:maxLines="8"
            android:breakStrategy="high_quality"
            android:paddingHorizontal="20dp"
            android:textAllCaps="false"
            android:drawableTop="@drawable/ic_baseline_chapter_1"
            android:drawablePadding="11dp"
            android:textColor="?attr/colorTextBlackWhite"
            tools:text="@string/app_name" />
    </androidx.cardview.widget.CardView>

</FrameLayout>
