<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="430dp"
    android:layout_height="752dp"
    android:layout_gravity="center"
    android:background="@drawable/share_sheet_background">

    <!-- Header with logo, title, and close button -->
    <RelativeLayout
        android:id="@+id/header_container"
        android:layout_width="398dp"
        android:layout_height="40dp"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="16dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="16dp">

        <!-- Logo container -->
        <RelativeLayout
            android:id="@+id/logo_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentLeft="true"
            android:background="@drawable/logo_container">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_baseline_lung"
                android:scaleType="centerInside" />
        </RelativeLayout>

        <!-- Title and subtitle container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/logo_container"
            android:layout_centerVertical="true"
            android:layout_marginLeft="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/share_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Page Title"
                android:textAppearance="@style/EditNoteTextStyle"
                android:textSize="16sp"
                android:textColor="#343434" />

            <TextView
                android:id="@+id/share_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="GeorgiaTBReferenceGuide.com/2/3"
                android:textSize="12sp"
                android:textColor="#666666" />
        </LinearLayout>

        <!-- Close button -->
        <RelativeLayout
            android:id="@+id/close_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackground"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_close"
                android:scaleType="centerInside" />
        </RelativeLayout>
    </RelativeLayout>

    <!-- Separator -->
    <View
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@id/header_container"
        android:layout_marginTop="20.5dp"
        android:background="#5C3C3C43"
        android:alpha="0.5" />

    <!-- Share to people section -->
    <RelativeLayout
        android:id="@+id/share_to_people"
        android:layout_width="375dp"
        android:layout_height="98dp"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="16dp"
        android:layout_below="@id/separator"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/share_to_people_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:text="Share to people"
            android:textAppearance="@style/EditNoteTextStyle"
            android:textColor="#343434"
            android:textSize="14sp" />

        <!-- Add some sample people avatars here if needed -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/share_to_people_title"
            android:layout_marginTop="16dp"
            android:text="People avatars would go here"
            android:textColor="#999999"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- Second separator -->
    <View
        android:id="@+id/separator2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@id/share_to_people"
        android:layout_marginTop="20dp"
        android:background="#5C3C3C43"
        android:alpha="0.5" />

    <!-- Share to apps section -->
    <RelativeLayout
        android:id="@+id/share_to_apps"
        android:layout_width="375dp"
        android:layout_height="77dp"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="16dp"
        android:layout_below="@id/separator2"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/share_to_apps_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:text="Share to apps"
            android:textAppearance="@style/EditNoteTextStyle"
            android:textColor="#343434"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/share_apps_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/share_to_apps_title"
            android:layout_marginTop="12dp"
            android:overScrollMode="never" />
    </RelativeLayout>

    <!-- Action rows -->
    <LinearLayout
        android:id="@+id/action_rows"
        android:layout_width="398dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/share_to_apps"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <!-- Copy Link -->
        <RelativeLayout
            android:id="@+id/copy_link_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/action_row_background"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:text="Copy link"
                android:textAppearance="@style/EditNoteTextStyle"
                android:textColor="#343434"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_baseline_clear_content"
                android:scaleType="centerInside" />
        </RelativeLayout>

        <!-- Add to Reading List -->
        <RelativeLayout
            android:id="@+id/reading_list_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/action_row_background"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:text="Add to reading list"
                android:textAppearance="@style/EditNoteTextStyle"
                android:textColor="#343434"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_baseline_notes"
                android:scaleType="centerInside" />
        </RelativeLayout>

        <!-- Add to Bookmark -->
        <RelativeLayout
            android:id="@+id/bookmark_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/action_row_background"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:text="Add to bookmark"
                android:textAppearance="@style/EditNoteTextStyle"
                android:textColor="#343434"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_baseline_folder_bookmarked"
                android:scaleType="centerInside" />
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>
