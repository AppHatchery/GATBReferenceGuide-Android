<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="34dp"
    android:paddingEnd="34dp"
    android:clipToPadding="false">

    <RelativeLayout
        android:layout_width="364dp"
        android:layout_height="254dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/rectangle_4">

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:text="@string/bookmark_na"
        android:textAppearance="@style/bookmark_na"
        android:gravity="top" />

    <!-- Close Icon -->
    <ImageView
        android:id="@+id/close_dialog"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="2dp"
        android:src="@drawable/ic_baseline_close"
        app:tint="@color/reddish" />

    <!-- Bookmark Name Input Field -->
    <RelativeLayout
        android:id="@+id/bookmark_name_container"
        android:layout_width="323dp"
        android:layout_height="37dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="20dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="51dp"
        android:clipToOutline="true"
        android:background="@drawable/dialog_small_container_background">

        <EditText
            android:id="@+id/bookmark_name_edit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:gravity="start|center_vertical"
            android:hint="Enter bookmark name..."
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#343434"
            android:textColorHint="#747474"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />

    </RelativeLayout>

    <!-- Bookmark Source Label -->
    <TextView
        android:id="@+id/bookmark_source_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="108dp"
        android:text="@string/bookmark_so"
        android:textAppearance="@style/bookmark_so"
        android:gravity="top" />

    <!-- Bookmark Source (read-only) -->
    <RelativeLayout
        android:id="@+id/bookmark_source_container"
        android:layout_width="323dp"
        android:layout_height="61dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="20dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="143dp"
        android:clipToOutline="true"
        android:background="@drawable/dialog_large_container_background">

        <TextView
            android:id="@+id/bookmark_source_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="18dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_baseline_chapter_2"
            android:drawablePadding="6dp"
            android:text="@string/treatment_r"
            android:textAppearance="@style/treatment_r"
            android:textColor="#747474"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/bookmark_source_full"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="17dp"
            android:layout_below="@id/bookmark_source_name"
            android:layout_marginStart="12dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="8dp"
            android:text="@string/iii_treatme"
            android:textAppearance="@style/iii_treatme"
            android:textColor="#747474"
            android:singleLine="true"
            android:ellipsize="end" />

    </RelativeLayout>

    <!-- Delete Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/delete_bookmark_button"
        android:layout_width="182dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="214dp"
        android:background="@drawable/bookmark_popup_visit_button_bg"
        android:backgroundTint="@null"
        android:text="Delete"
        android:textColor="#343434"
        android:textSize="14sp"
        android:textAllCaps="false" />

    <!-- Save Changes Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/save_changes_button"
        android:layout_width="182dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="0dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="214dp"
        android:background="@drawable/bookmark_popup_dismiss_button_bg"
        android:backgroundTint="@null"
        android:text="Save Changes"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textAllCaps="false" />


    </RelativeLayout>

</FrameLayout>
