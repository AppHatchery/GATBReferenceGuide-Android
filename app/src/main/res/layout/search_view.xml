<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_view_container"
    android:layout_width="match_parent"
    android:layout_height="86dp"
    android:background="@drawable/search_view_background"
    android:clipToOutline="true"
    android:paddingTop="22dp"
    android:paddingBottom="24dp"
    android:paddingStart="38dp"
    android:paddingEnd="38dp">

    <!-- Search input (transitions from full width to 213dp) -->
    <EditText
        android:id="@+id/search_edit_text"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:background="@drawable/search_input_background"
        android:hint="Enter Keywords to Search"
        android:textColorHint="#666666"
        android:textColor="#000000"
        android:textSize="16sp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:drawableStart="@drawable/ic_baseline_search_24"
        android:drawablePadding="10dp"
        android:paddingStart="9dp"
        android:paddingEnd="40dp" />

    <!-- Clear button -->
    <ImageView
        android:id="@+id/search_clear"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignEnd="@id/search_edit_text"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_baseline_clear_content"
        android:tint="@color/reddish"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <!-- Search results counter (initially hidden) -->
    <TextView
        android:id="@+id/search_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/search_edit_text"
        android:layout_centerVertical="true"
        android:layout_marginStart="21dp"
        android:text="2/3"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/inter_regular"
        android:visibility="gone" />

    <!-- left arrow -->
    <ImageView
        android:id="@+id/search_previous"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_toEndOf="@id/search_counter"
        android:layout_centerVertical="true"
        android:layout_marginStart="30dp"
        android:src="@drawable/ic_baseline_prev"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="#FFFFFF"
        android:visibility="gone" />

    <!-- right arrow -->
    <ImageView
        android:id="@+id/search_next"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_toEndOf="@id/search_previous"
        android:layout_centerVertical="true"
        android:layout_marginStart="26dp"
        android:src="@drawable/ic_baseline_next"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="#FFFFFF"
        android:visibility="gone" />

</RelativeLayout>
