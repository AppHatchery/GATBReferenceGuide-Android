<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/chapterBackgroundColorWhite"
            android:padding="24dp">

            <!-- Quote text -->
            <TextView
                android:id="@+id/quote_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/inter_regular"
                android:text="&quot;Tuberculosis is an ancient disease but we don't have to keep the technology ancient&quot;"
                android:textColor="?attr/colorTextBlackWhite"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/author_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_regular"
                android:text="-TB Nurse Consultant, Oct 2021"
                android:textColor="?attr/colorTextBlackWhite"
                android:textSize="14sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Font size slider section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:background="?attr/chapterBackgroundColorGrey"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="20dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/slider_small_font_icon"
                    android:paddingHorizontal="10dp"
                    android:src="@drawable/ic_small_font" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/font_size_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="25"
                    android:valueFrom="100"
                    android:valueTo="175"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/white"
                    app:thumbElevation="3dp"
                    app:thumbRadius="13dp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/slider_large_font_icon"
                    android:paddingHorizontal="10dp"
                    android:src="@drawable/ic_large_font" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
