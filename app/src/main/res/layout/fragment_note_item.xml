<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="8dp">

    <!-- Content Container with Background -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="95dp"
        android:background="@drawable/note_item_background"
        android:elevation="32dp">

        <!-- Left colored bar -->
        <View
            android:id="@+id/note_left_bar"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="@drawable/note_left_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <!-- Note Title -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textview_note_body"
            android:layout_width="0dp"
                android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="17dp"
            android:layout_marginEnd="30dp"
            android:text="@string/state_guide"
            android:textAppearance="@style/state_guide"
            android:gravity="top"
                android:maxLines="2"
            app:layout_constraintEnd_toStartOf="@+id/note_edit_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="State guidelines have changed for LTBI Treatment" />

        <!-- Edit Icon -->
        <ImageView
            android:id="@+id/note_edit_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            android:src="@drawable/ic_baseline_edit_note"
            android:contentDescription="Edit note"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/reddish"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Note Subtitle -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textview_note_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="17dp"
            android:text="@string/note_last_e"
            android:textAppearance="@style/note_last_e"
            android:gravity="top"
                app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textview_note_body"
            tools:text="Note - Last Edited 03/12/2024" />

        <!-- Show in chapter (Hidden by default) -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textview_show_chapter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:drawableEnd="@drawable/ic_keyboard_arrow_right"
                android:text="Show in chapter"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textview_note_title"
                tools:ignore="HardcodedText" />

        </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>