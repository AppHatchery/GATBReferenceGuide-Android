<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="33dp"
    android:layout_marginEnd="33dp"
    android:layout_marginBottom="32dp">

    <!-- Content Container with Background -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:background="@drawable/chart_bookmark_background"
        android:elevation="32dp">

        <!-- Left colored bar -->
        <View
            android:id="@+id/chart_bookmark_left_bar"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="@drawable/chart_bookmark_left_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Chart Bookmark Title (Top) -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textview_chart_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="17dp"
            android:layout_marginEnd="30dp"
            android:text="@string/firstline"
            android:textAppearance="@style/firstline"
            android:gravity="top"
            android:singleLine="true"
            android:ellipsize="end"
            app:layout_constraintEnd_toStartOf="@+id/chart_edit_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="FirstLine" />

        <!-- Edit Icon (Top Right) -->

        <!-- Chart Source with Chart Icon -->
        <ImageView
            android:id="@+id/chart_edit_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit chart bookmark"
            android:padding="8dp"
            android:src="@drawable/ic_baseline_edit_note"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/reddish" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textview_chart_source"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="17dp"
            android:text="@string/first_line_"
            android:textAppearance="@style/first_line_"
            android:gravity="top"
            android:drawableStart="@drawable/ic_baseline_charts_2"
            android:drawablePadding="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textview_chart_title"
            tools:text="First Line TB Drugs for Adults" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
