<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.BodyFragment">

    <View
        android:id="@+id/view"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/view_in_cha"
        android:layout_width="281dp"
        android:layout_height="28dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="24dp"
        android:text="@string/view_in_cha"
        android:textAppearance="@style/view_in_cha"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:maxLines="1"
        android:ellipsize="end"
        android:foreground="?attr/selectableItemBackground"
        android:drawableEnd="@drawable/ic_baseline_next"
        android:drawablePadding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_view_include"
        tools:text="View in Chapter -> Treatment Regimens" />

    <!-- Last Update Text for Charts -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/chart_last_update_textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="0dp"
        android:textStyle="italic"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_in_cha"
        tools:ignore="HardcodedText"
        tools:text="Last updated 06/17/21" />

    <!-- Separator for Charts -->
    <View
        android:id="@+id/chart_separator"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:paddingBottom="16dp"
        android:background="@drawable/separator"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chart_last_update_textView" />

    <!-- Search View positioned after action bar -->
    <include
        android:id="@+id/search_view_include"
        layout="@layout/search_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Updated the main content constraint to start from search view -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="27.5dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_view_include"
        app:layout_constraintVertical_bias="0.0">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingBottom="32dp">

            <!-- Chapter Title -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textview_sub_chapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="0dp"
                android:clickable="true"
                android:drawableStart="@drawable/ic_baseline_chapter_2"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="17dp"
                android:textSize="17sp"
                android:visibility="visible"
                tools:ignore="HardcodedText"
                tools:text="@string/app_name" />

            <!-- Last Update Text -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/last_update_textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="0dp"
                android:textStyle="italic"
                android:visibility="visible"
                tools:ignore="HardcodedText"
                tools:text="Last updated 06/17/21" />

            <!-- Separator -->
            <View
                android:id="@+id/separator"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/separator" />


            <org.apphatchery.gatbreferenceguide.views.BaseWebView
                android:id="@+id/body_web_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:paddingBottom="16dp"
                android:scrollbars="vertical" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout

        android:id="@+id/search_clear_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="8dp"
        android:padding="16dp"
        android:visibility="gone"
        android:background="@drawable/shape_dialog_rounded"
        app:layout_constraintBottom_toTopOf="@+id/bottom_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintStart_toEndOf="parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="@+id/search_clear_container"
            app:layout_constraintTop_toTopOf="@+id/search_clear_container"
            app:layout_constraintBottom_toBottomOf="@+id/search_clear_container">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/search_clear_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Searching: "
                tools:ignore="HardcodedText"
                tools:text="Last updated 06/17/21" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/search_clear_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                tools:text="Last updated 06/17/21" />
        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/search_clear_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:foreground="?attr/actionBarItemBackground"

            android:src="@drawable/ic_close"
            app:layout_constraintEnd_toEndOf="@+id/search_clear_container"
            app:layout_constraintTop_toTopOf="@+id/search_clear_container"
            app:layout_constraintBottom_toBottomOf="@+id/search_clear_container" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Chapter and Chart Bottom Toolbar -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="84dp"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:paddingTop="17dp"
        android:paddingBottom="26dp"
        android:gravity="center"
        android:translationZ="500dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="?attr/colorWhiteGray">
        <!--Home-->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/home_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:foreground="?attr/actionBarItemBackground"
                android:padding="8dp"
                android:tint="?attr/colorGrayWhite"
                android:src="@drawable/ic_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="?attr/colorGrayWhite"
                android:textSize="12sp"
                android:text="@string/home" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!--Share-->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/share_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:foreground="?attr/actionBarItemBackground"
                android:padding="8dp"
                android:tint="?attr/colorGrayWhite"
                android:src="@drawable/ic_baseline_share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="?attr/colorGrayWhite"
                android:textSize="12sp"
                android:text="@string/share" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!--Bookmark-->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:orientation="vertical"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/bookmarkImageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:foreground="?attr/actionBarItemBackground"
                android:padding="8dp"
                android:src="@drawable/ic_baseline_folder_outline" />

            <TextView
                android:id="@+id/isBookmarkedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="?attr/colorGrayWhite"
                android:textSize="12sp"
                android:text="@string/bookmark" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!--Note-->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:orientation="vertical"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/add_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:foreground="?attr/actionBarItemBackground"
                android:padding="8dp"
                android:tint="?attr/colorGrayWhite"
                android:src="@drawable/ic_baseline_edit_note" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="?attr/colorGrayWhite"
                android:textSize="12sp"
                android:text="@string/note" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Font -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/change_font_size_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:foreground="?attr/actionBarItemBackground"
                android:padding="8dp"
                android:tint="?attr/colorGrayWhite"
                android:src="@drawable/ic_baseline_increase_font_size" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="?attr/colorGrayWhite"
                android:textSize="12sp"
                android:text="@string/font" />
        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- Floating Notes Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_notes_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_baseline_edit_note"
        android:contentDescription="Show Notes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_view_include"
        app:backgroundTint="@color/reddish"
        app:tint="@android:color/white" />

    <!-- Note Deletion Confirmation Card -->
    <include
        android:id="@+id/delete_card_container"
        layout="@layout/include_confirmation_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
